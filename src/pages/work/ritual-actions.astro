      "/images/performances/black-rabbit/04.jpg",
    ],
  },
  {
    title: "Empty Head",
    year: "2024",
    location: "Araucaria Gallery, Barcelona",
    slug: "empty-head",
    images: [
      "/images/performances/empty-head/lead.jpg",
      "/images/performances/empty-head/02.jpg",
      "/images/performances/empty-head/03.jpg",
      "/images/performances/empty-head/04.jpg",
    ],
  },
  {
    title: "Dark Cloud and Gold Wind",
    year: "2024",
    location: "Fuerteventura, Canary Islands",
    slug: "dark-cloud",
    images: [
      "/images/performances/dark-cloud/lead.jpg",
      "/images/performances/dark-cloud/02.jpg",
      "/images/performances/dark-cloud/03.jpg",
      "/images/performances/dark-cloud/04.jpg",
    ],
  },
  {
    title: "Pulse",
    year: "2024",
    location: "The Local AIR, Valencia",
    slug: "pulse",
    images: ["/images/performances/pulse/lead.jpg"],
  },
  {
    title: "Dodole",
    year: "2024",
    location: "Entresuelos, Barcelona",
    slug: "dodole",
    images: [],
  },
  {
    title: "Kiss Me",
    year: "2024",
    location: "Barcelona",
    slug: "kiss-me",
    note: "Began with a dream in 2019 — a kiss through glass that felt as real as if nothing separated the two people. The question: does the barrier change what is felt, or only what we allow ourselves? The performance invites strangers to kiss through glass, a gesture the glass makes possible precisely because it is there.",
    images: [],
  },
  {
    title: "Home / Let It Be",
    year: "2023",
    location: "Entresuelos, Barcelona",
    slug: "home-let-it-be",
    images: [
      "/images/performances/home/lead.jpg",
      "/images/performances/let-it-be/lead.jpg",
    ],
  },
  {
    title: "Thank You and Good Bye",
    year: "2021–2023",
    location: "Belgrade",
    slug: "thank-you",
    images: [
      "/images/performances/thank-you/lead.jpg",
      "/images/performances/thank-you/02.jpg",
      "/images/performances/thank-you/03.jpg",
    ],
  },
  {
    title: "La Sombra",
    year: "2019",
    location: "Barcelona",
    slug: "la-sombra",
    images: [
      "/images/performances/la-sombra/lead.jpg",
      "/images/performances/la-sombra/02.jpg",
      "/images/performances/la-sombra/03.jpg",
    ],
  },
  {
    title: "Gold Wings",
    year: "2019",
    location: "Belgrade",
    slug: "gold-wings",
    images: [],
  },
  {
    title: "Voice of the Rain",
