---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const gallery = [
  "/images/painting-drawing/02.jpg",
  "/images/painting-drawing/03.jpg",
  "/images/painting-drawing/04.jpg",
  "/images/painting-drawing/05.jpg",
  "/images/painting-drawing/06.jpg",
  "/images/painting-drawing/07.jpg",
  "/images/painting-drawing/08.jpg",
  "/images/painting-drawing/09.jpg",
  "/images/painting-drawing/10.jpg",
  "/images/painting-drawing/11.jpg",
  "/images/painting-drawing/12.jpg",
  "/images/painting-drawing/13.jpg",
];
---

<Layout
  title="Painting and Drawing — Gordana Zikic"
  description="Painting and drawing — large-format works on raw canvas, gestural and full-body process."
>
  <Nav slot="nav" />

  <article class="project-page">
    <div class="container">
      <header class="project-header">
        <a href="/work" class="back mono">← Work</a>
        <h1 class="project-title">Painting and Drawing</h1>
        <p class="mono project-meta">Painting, drawing · Recent exhibition: Unbound, Detroit Stockholm, Stockholm, 2025</p>
        <span class="type-tag mono">Painting · Drawing</span>
      </header>
    </div>

    <div class="lead-image-wrap">
      <img src="/images/painting-drawing/lead.jpg" alt="Painting and Drawing — Unbound, Detroit Stockholm, Stockholm 2025" loading="eager" class="lead-image" />
    </div>

    <div class="container project-body">
      <div class="project-description">
        <span class="section-rule"></span>
        <p>
          Large-format paintings made on raw canvas sized to the body — the arm span and height as measure.
          The process is gestural and full-body, the canvas on the floor or wall, charcoal and paint applied
          through movement rather than from a distance.
        </p>
        <p>
          The abstract drawings extend the same investigation at smaller scale. Recent work was presented in the
          solo exhibition <em>Unbound</em>, Detroit Stockholm, Stockholm, 2025.
        </p>
      </div>

      <div class="project-gallery">
        {gallery.map((src) => (
          <div class="gallery-item">
            <img src={src} alt="Painting and Drawing" loading="lazy" onerror="this.parentElement.style.display='none'" />
          </div>
        ))}
      </div>
    </div>
  </article>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close">×</button>
    <img src="" alt="" class="lightbox-image" id="lightbox-img" />
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .project-page { padding-top: 3rem; }
  .project-header { margin-bottom: 3rem; }
  .back { display: inline-block; margin-bottom: 1.5rem; transition: color 0.15s; }
  .back:hover { color: var(--accent); }
  .project-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 400; margin-bottom: 0.75rem; line-height: 1.1; }
  .project-meta { margin-bottom: 0.75rem; color: var(--muted); }
  .type-tag { display: inline-block; border: 1px solid var(--border); padding: 0.25rem 0.6rem; border-radius: 2px; }
  .lead-image-wrap { width: 100%; max-height: 85vh; overflow: hidden; margin: 2rem 0; background: #2a2420; }
  .lead-image { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; cursor: zoom-in; }
  .project-body { padding-bottom: 4rem; }
  .project-description { max-width: var(--content-width); margin-bottom: 4rem; }
  .project-description p { font-size: 1.15rem; line-height: 1.75; margin-bottom: 1.25rem; }
  .project-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .gallery-item { overflow: hidden; background: #e8e4de; cursor: zoom-in; aspect-ratio: 1/1; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .gallery-item:hover img { transform: scale(1.03); }
  .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 1000; align-items: center; justify-content: center; }
  .lightbox.open { display: flex; }
  .lightbox-image { max-width: 92vw; max-height: 92vh; object-fit: contain; }
  .lightbox-close { position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; color: white; font-size: 2.5rem; cursor: pointer; line-height: 1; opacity: 0.8; font-family: var(--font-heading); }
  .lightbox-close:hover { opacity: 1; }
  @media (max-width: 768px) { .project-gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close')!;
  document.querySelectorAll('.lead-image, .gallery-item img').forEach((img) => {
    img.addEventListener('click', () => {
      const el = img as HTMLImageElement;
      lightboxImg.src = el.src;
      lightboxImg.alt = el.alt;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });
  const closeLightbox = () => { lightbox.classList.remove('open'); document.body.style.overflow = ''; };
  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
