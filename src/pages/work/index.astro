---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Placeholder from '../../components/Placeholder.astro';

const sections = [
  { title: "The Sea", slug: "the-sea", type: "Standing investigation" },
  { title: "Ritual Objects & Space", slug: "ritual-objects", type: "Installation · Objects · Research" },
  { title: "Performances", slug: "performances", type: "Ritual · Threshold · Body" },
  { title: "Field Notes", slug: "field-notes", type: "Diaristic photography" },
  { title: "Body, Painting, Drawing & Traces", slug: "body-painting", type: "Painting · Drawing · Collaboration" },
];

const collaborations = [
  { title: "Unbound", slug: "body-painting/unbound", meta: "Two-person exhibition · Detroit Stockholm, Stockholm · 2025", with: "Bosko Begovic" },
  { title: "Movement / Traces", slug: "body-painting/movement-traces", meta: "AR research · In development", with: "Bosko Begovic" },
  { title: "Divine Grip", slug: "body-painting/divine-grip", meta: "U10 Gallery, Belgrade · 2017", with: "Bosko Begovic" },
];
---

<Layout title="Work — Gordana Zikic">
  <Nav slot="nav" />

  <div class="container work-page">
    <header class="work-header">
      <span class="section-rule"></span>
      <h1>Work</h1>
    </header>

    <div class="sections-grid">
      {sections.map((s) => (
        <a href={`/work/${s.slug}`} class="section-card">
          <div class="card-image">
            <Placeholder label={s.title} />
          </div>
          <div class="card-info">
            <span class="mono card-type">{s.type}</span>
            <h2 class="card-title">{s.title}</h2>
          </div>
        </a>
      ))}
    </div>

    <div class="collab-section">
      <div class="collab-header">
        <span class="mono collab-label">Collaborations with Bosko Begovic</span>
      </div>
      <div class="collab-grid">
        {collaborations.map((c) => (
          <a href={`/work/${c.slug}`} class="collab-card">
            <div class="collab-image">
              <Placeholder label={c.title} />
            </div>
            <div class="collab-info">
              <span class="mono collab-with">{c.with}</span>
              <h3 class="collab-title">{c.title}</h3>
              <p class="mono collab-meta">{c.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .work-page {
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .work-header {
    margin-bottom: 3rem;
  }

  .work-header h1 {
    font-size: 2.5rem;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem 3rem;
    margin-bottom: 6rem;
  }

  .section-card {
    display: block;
    cursor: pointer;
  }

  .card-image {
    overflow: hidden;
    margin-bottom: 1rem;
    transition: opacity 0.2s;
  }

  .section-card:hover .card-image {
    opacity: 0.85;
  }

  .card-info {
    padding: 0;
  }

  .card-type {
    display: block;
    margin-bottom: 0.3rem;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    transition: color 0.15s;
  }

  .section-card:hover .card-title {
    color: var(--accent);
  }

  /* Collaborations */
  .collab-section {
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
  }

  .collab-header {
    margin-bottom: 2rem;
  }

  .collab-label {
    font-size: 0.68rem;
    color: var(--muted);
  }

  .collab-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .collab-card {
    display: block;
  }

  .collab-image {
    margin-bottom: 0.85rem;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .collab-card:hover .collab-image {
    border-color: var(--accent);
  }

  .collab-with {
    display: block;
    font-size: 0.62rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .collab-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
    transition: color 0.15s;
  }

  .collab-card:hover .collab-title {
    color: var(--accent);
  }

  .collab-meta {
    font-size: 0.65rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .sections-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .collab-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
