---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Placeholder from '../components/Placeholder.astro';
---

<Layout title="Archive — Gordana Zikic">
  <Nav slot="nav" />

  <div class="container archive-page">
    <header>
      <span class="section-rule"></span>
      <h1>Archive</h1>
      <p class="mono archive-note">Works 2004–2018 not included in the current selection</p>
    </header>

    <div class="archive-grid">
      <p class="mono empty-note">[Works to be added]</p>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .archive-page { padding-top: 4rem; padding-bottom: 4rem; }
  header { margin-bottom: 3rem; }
  h1 { font-size: 2.5rem; font-weight: 400; margin-bottom: 0.5rem; }
  .archive-note { color: var(--muted); }
  .archive-grid { min-height: 200px; display: flex; align-items: center; }
  .empty-note { color: #c0bab3; font-size: 0.72rem; }
</style>
