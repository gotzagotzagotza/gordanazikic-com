<style>
  .cv-page {
    padding-top: 4rem;
    padding-bottom: 2rem;
    max-width: 860px;
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4rem;
    gap: 2rem;
  }

  .cv-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.35rem;
  }

  .cv-subtitle {
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  .cv-location {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .cv-download {
    display: inline-block;
    white-space: nowrap;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--text);
    transition: background 0.15s, color 0.15s;
    font-size: 0.72rem;
  }

  .cv-download:hover {
    background: var(--text);
    color: var(--bg);
  }

  .cv-body {
    border-top: 1px solid var(--border);
  }

  .cv-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0 2rem;
  }

  .cv-section-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    padding-top: 0.2rem;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 1rem;
    align-items: baseline;
  }

  .cv-year {
    font-size: 0.72rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  .cv-content {
    font-size: 0.97rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .cv-header {
      flex-direction: column;
    }

    .cv-section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 500px) {
    .cv-entry {
      grid-template-columns: 60px 1fr;
    }
  }
</style>
