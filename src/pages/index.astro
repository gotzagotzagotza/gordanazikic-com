---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Placeholder from '../components/Placeholder.astro';
---

<Layout title="Gordana Zikic — Interdisciplinary Artist">
  <Nav slot="nav" />

  <section class="hero container">
    <div class="hero-image-wrap">
      <img
        src="/images/hero.jpg"
        alt="Gordana Zikic"
        class="hero-image"
        loading="eager"
        id="hero-img"
      />
      <div class="hero-placeholder" id="hero-placeholder" aria-hidden="true">
        <Placeholder label="Hero image" minHeight="60vh" />
      </div>
    </div>
    <div class="hero-name">
      <h1>Gordana Zikic</h1>
      <p class="hero-subtitle mono">Interdisciplinary Artist · Barcelona</p>
    </div>
  </section>

  <section class="intro container">
    <p class="intro-text">
      Twenty years of practice across painting, installation, performance,
      photography, and wearable objects — always at the threshold of embodied
      experience, shamanic research, and contemporary life.
    </p>
    <a href="/work" class="intro-link mono">View work →</a>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .hero {
    padding-top: 3rem;
    padding-bottom: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-image-wrap {
    width: 100%;
    max-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-placeholder {
    width: 100%;
    display: none;
  }

  .hero-placeholder.visible {
    display: block;
  }

  .hero-name {
    text-align: center;
    padding: 2rem 0 1rem;
  }

  .hero-name h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    color: var(--muted);
  }

  .intro {
    padding: 3rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 640px;
  }

  .intro-text {
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .intro-link {
    display: inline-block;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: opacity 0.15s;
  }
  .intro-link:hover { opacity: 0.75; }
</style>

<script>
  const img = document.getElementById('hero-img') as HTMLImageElement;
  const ph = document.getElementById('hero-placeholder')!;
  if (img) {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      ph.classList.add('visible');
    });
    if (img.complete && img.naturalWidth === 0) {
      img.style.display = 'none';
      ph.classList.add('visible');
    }
  }
</script>
