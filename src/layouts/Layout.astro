---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gordana Zikic",
  description = "Interdisciplinary artist based in Barcelona. Painting, installation, performance, photography, and wearable objects.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Mono:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #fbfaf8;
        --text: #1a1a1a;
        --accent: #c0392b;
        --muted: #7a7368;
        --border: #d8d3cc;

        --font-heading: 'Playfair Display', Georgia, serif;
        --font-body: 'EB Garamond', Georgia, serif;
        --font-mono: 'DM Mono', 'Courier New', monospace;

        --max-width: 1200px;
        --content-width: 800px;
        --nav-height: 60px;
      }

      html {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        padding-top: var(--nav-height);
      }

      h1, h2, h3, h4 {
        font-family: var(--font-heading);
        font-weight: 400;
        line-height: 1.2;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .mono {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
      }

      .section-rule {
        display: block;
        width: 40px;
        height: 2px;
        background: var(--accent);
        margin-bottom: 1.5rem;
      }

      @media (max-width: 768px) {
        html { font-size: 16px; }
        .container { padding: 0 1.25rem; }
      }
    </style>
  </head>
  <body>
    <slot name="nav" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
