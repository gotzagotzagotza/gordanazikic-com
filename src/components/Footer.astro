---
<footer class="site-footer">
  <div class="container footer-inner">
    <span class="mono">© {new Date().getFullYear()} Gordana Zikic</span>
    <nav class="footer-links">
      <a href="/archive" class="mono footer-link">Archive</a>
      <a href="/contact" class="mono footer-link">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 6rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-link {
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
