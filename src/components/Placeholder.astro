---
interface Props {
  label?: string;
}
const { label = '' } = Astro.props;
---
<div class="placeholder">
  <div class="placeholder-inner">
    {label && <span class="placeholder-label mono">{label}</span>}
  </div>
</div>

<style>
  .placeholder {
    background: #e8e4df;
    width: 100%;
    /* Neutral placeholder height — real images will override this naturally */
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .placeholder-label {
    font-size: 0.62rem;
    color: #9a9490;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }
</style>
